---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import BrandLogo from '../components/BrandLogo.astro';
import { organiser, supporters } from '../data/partners';

const details = [
  { label: 'Dates', value: '12 to 16 July 2027', note: 'Monday to Friday' },
  { label: 'Venue', value: 'Faculty of Computer Science', note: 'Universidade da Coruña' },
  { label: 'City', value: 'A Coruña', note: 'Galicia, Spain' },
];
---

<Layout title="ESSIR 2027 · 18th European Summer School on Information Retrieval" page="home">

  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__intro">
        <p class="label">18th European Summer School on Information Retrieval</p>
        <h1><BrandLogo variant="primary" /></h1>
        <div class="actions">
          <a href="/essir2027.ics" download class="btn btn--primary">Add to calendar</a>
          <a href="/attending" class="btn">Venue &amp; travel</a>
        </div>
      </div>

      <aside class="card" aria-label="Key details">
        <dl>
          {details.map(d => (
            <div class="card__row">
              <dt class="label">{d.label}</dt>
              <dd>{d.value}<span>{d.note}</span></dd>
            </div>
          ))}
        </dl>
        <p class="card__next"><span class="status">Soon</span> Programme, speakers and registration</p>
      </aside>
    </div>
  </section>

  <section class="container">
    <div class="section about">
      <h2 class="label">About ESSIR</h2>
      <div>
        <p>ESSIR is a summer school for PhD students, early-career researchers and practitioners working in information retrieval. Over five days, lecturers from the IR community cover the foundations of the field and current research, along with neighbouring areas such as recommender systems and natural language processing.</p>
        <p>The school has been held across Europe since 1990. Its 18th edition comes to A Coruña, organised by the Information Retrieval Lab (IRLab) at the Universidade da Coruña.</p>
        <a href="https://www.essir.eu/" class="more">More about the ESSIR series ↗</a>
      </div>
    </div>
  </section>

  <section class="container">
    <div class="partners">
      <div>
        <h2 class="label">Organised by</h2>
        <div class="logos"><Logo partner={organiser} /></div>
      </div>
      <div>
        <h2 class="label">Supported by</h2>
        <div class="logos">
          {supporters.map(p => <Logo partner={p} />)}
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: min(calc(100svh - 4rem), 46rem);
    padding-block: clamp(3rem, 8vw, 5rem);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: -10%;
    z-index: -1;
    background:
      radial-gradient(30rem 24rem at 18% 22%, color-mix(in srgb, #c6007e 20%, transparent), transparent 70%),
      radial-gradient(28rem 22rem at 48% 72%, color-mix(in srgb, #f3a6d6 30%, transparent), transparent 70%),
      radial-gradient(30rem 24rem at 82% 38%, color-mix(in srgb, color-mix(in srgb, #c6007e 50%, #56295b) 24%, transparent), transparent 70%);
    filter: blur(48px);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  h1 {
    width: clamp(18rem, 42vw, 34rem);
    margin-top: .5rem;
    transform: translateX(-8.4%);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-top: 2rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    height: 2.75rem;
    padding-inline: 1.25rem;
    border: 1px solid var(--line);
    border-radius: 100px;
    font-size: .9rem;
    font-weight: 500;
    transition: border-color .2s ease, background .2s ease, color .2s ease;
  }

  .btn:hover { border-color: var(--accent); color: var(--accent); }

  .btn--primary {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .btn--primary:hover { background: var(--accent); border-color: var(--accent); color: var(--bg); }

  .card {
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: 12px;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    backdrop-filter: blur(8px);
  }

  .card__row {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .card__row:first-child { padding-top: 0; }

  dd { font-weight: 500; }

  dd span {
    display: block;
    font-weight: 400;
    font-size: .9rem;
    color: var(--muted);
  }

  .card__next {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .25rem .75rem;
    padding-top: 1.25rem;
    font-size: .9rem;
    color: var(--muted);
  }

  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 1rem 2rem;
    border-top: 1px solid var(--line);
  }

  .about p { color: var(--muted); max-width: 62ch; }
  .about p + p { margin-top: .75rem; }

  .more {
    display: inline-block;
    margin-top: 1rem;
    font-size: .9rem;
    font-weight: 500;
    transition: color .2s ease;
  }

  .more:hover { color: var(--accent); }

  .partners {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 2.5rem 2rem;
    padding-top: clamp(2.5rem, 6vw, 4rem);
    border-top: 1px solid var(--line);
  }

  .logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem clamp(1.75rem, 4vw, 3rem);
    min-height: 3.5rem;
    margin-top: 1.25rem;
  }

  @media (max-width: 860px) {
    .hero { min-height: 0; }
    .hero__grid, .about, .partners { grid-template-columns: 1fr; }
  }
</style>
