---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import TravelOptions from '../components/TravelOptions.astro';
import { airports, toCity, toCampus } from '../data/travel';
import { sights } from '../data/coruna';

const tba = ['Accommodation', 'Registration', 'Visa'];
const place = encodeURIComponent('Facultade de Informática, Campus de Elviña, A Coruña');

const seasonal = (r: string) => r.endsWith('*');
const routeName = (r: string) => r.replace(/\*$/, '');
---

<Layout
  title="Attending · ESSIR 2027"
  description="Practical information for attending ESSIR 2027, 12 to 16 July 2027, A Coruña, Spain: how to get there, what to see and the 2027 Holy Year in Santiago."
  page="attending"
>
  <PageHeader eyebrow="Practical information" title="Attending" />

  <div class="container">
    <div class="rows">
      <section class="row">
        <h2>A Coruña</h2>
        <div class="wide">
          <p>A Coruña is a port city of about 250,000 people on the Atlantic coast of <a href="https://en.wikipedia.org/wiki/Galicia_(Spain)">Galicia</a>, in north-west Spain. Most of it sits on a narrow peninsula, so the sea is never far, and it is easy to see on foot. Summers are mild and rarely very hot, and in July there is daylight until around 10 pm, which leaves long evenings after the lectures.</p>

          <ul class="sights">
            {sights.map(s => (
              <li class="sight">
                {s.image && <img src={s.image} alt={s.name} loading="lazy" width="800" height="500" />}
                <div class="sight__body">
                  <h3>{s.href ? <a href={s.href}>{s.name} ↗</a> : s.name}</h3>
                  <p>{s.text}</p>
                </div>
              </li>
            ))}
          </ul>

          <a href="https://www.coruna.gal/tourism/en" class="more">Visit A Coruña ↗</a>
        </div>
      </section>

      <section class="row">
        <h2>Getting to A Coruña</h2>
        <div class="wide">
          <p>Three airports in Galicia are linked to A Coruña by train. Santiago has the most direct flights, including to the United States; A Coruña is the closest; Vigo has domestic flights. Madrid and Barcelona connect with all three.</p>

          <ul class="airports">
            {airports.map(a => (
              <li class="airport">
                <header>
                  <span class="label">{a.code} · {a.distance}</span>
                  <h3>{a.name}</h3>
                </header>
                {a.note && <p>{a.note}</p>}
                <p>{a.transfer}</p>
                {a.international.length > 0 && (
                  <div>
                    <h4 class="label">Direct international</h4>
                    <ul class="routes">
                      {a.international.map(r => <li class:list={{ seasonal: seasonal(r) }}>{routeName(r)}</li>)}
                    </ul>
                  </div>
                )}
                <div>
                  <h4 class="label">Direct in Spain</h4>
                  <ul class="routes">
                    {a.domestic.map(r => <li class:list={{ seasonal: seasonal(r) }}>{routeName(r)}</li>)}
                  </ul>
                </div>
                {a.announced && a.announced.length > 0 && (
                  <div class="announced">
                    <h4 class="label">Announced, not flying yet</h4>
                    <ul class="routes">
                      {a.announced.map(r => <li>{r}</li>)}
                    </ul>
                  </div>
                )}
                <a href={a.href} class="more">All destinations ↗</a>
              </li>
            ))}
          </ul>
          <p class="fine">Solid routes fly all year. Dashed routes fly in summer only and are based on the 2026 season. Announced routes have been announced by the airlines but had not started in November 2026. Check the airport’s destinations page before booking.</p>

          <TravelOptions options={toCity} />
        </div>
      </section>

      <section class="row row--top">
        <h2>Santiago and the Holy Year</h2>
        <div class="wide">
          <img class="photo" src="/images/santiago.webp" alt="The cathedral of Santiago de Compostela above the roofs of the old town" loading="lazy" width="1200" height="800" />
          <p><a href="https://www.santiagoturismo.com/?lang=en">Santiago de Compostela</a> is 30 minutes from A Coruña by train and worth at least an afternoon: its old town and cathedral, the end of the <a href="https://en.wikipedia.org/wiki/Camino_de_Santiago">Camino de Santiago</a>, are a UNESCO World Heritage Site.</p>
          <p>2027 is a <a href="https://en.wikipedia.org/wiki/Jacobean_Holy_Year">Compostelan Holy Year</a>, since the feast of St James, 25 July, falls on a Sunday. It comes round only every six or eleven years: the cathedral’s Holy Door opens for the whole year and pilgrims arrive from all over the world.</p>
          <p>So there is one more way to reach the school, the traditional one: walk one of the Caminos to Santiago and take the train to A Coruña from there. A Coruña is itself a starting point of the <a href="https://en.wikipedia.org/wiki/English_Way">Camino Inglés</a>, so you can also start walking at the door of the school and reach Santiago in about four days.</p>
        </div>
      </section>

      <section class="row">
        <h2>Venue</h2>
        <div class="wide">
          <p>Faculty of Computer Science, Universidade da Coruña</p>
          <iframe
            class="map"
            title="Map of the Faculty of Computer Science, Universidade da Coruña"
            src={`https://www.google.com/maps?q=${place}&z=16&output=embed`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </section>

      <section class="row">
        <h2>Getting to the venue</h2>
        <div class="wide"><TravelOptions options={toCampus} /></div>
      </section>

      {tba.map(t => (
        <section class="row">
          <h2>{t}</h2>
          <span class="status">TBA</span>
        </section>
      ))}
    </div>
  </div>
</Layout>

<style>
  .wide {
    grid-column: 2 / -1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .map {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  .wide p a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: .2em;
    transition: color .2s ease, text-decoration-color .2s ease;
  }

  .wide p a:hover { color: var(--accent); text-decoration-color: currentColor; }

  .more {
    align-self: flex-start;
    font-size: .9rem;
    font-weight: 500;
    transition: color .2s ease;
  }

  .more:hover { color: var(--accent); }

  h3 {
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -.01em;
  }

  h3 a { transition: color .2s ease; }
  h3 a:hover { color: var(--accent); }

  /* Sights */
  .sights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: .5rem;
  }

  /* An odd last card spans the full width with a wider photo. */
  .sight:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .sight:last-child:nth-child(odd) img { aspect-ratio: 21 / 9; }

  .row--top { align-items: start; }

  .photo {
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    border-radius: 12px;
    margin-bottom: .5rem;
  }

  .sight {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  .sight img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .sight__body {
    display: flex;
    flex-direction: column;
    gap: .4rem;
    padding: 1.1rem 1.25rem 1.25rem;
  }

  .sight p { font-size: .95rem; }

  /* Airports */
  .airports {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: .5rem;
  }

  .airport:first-child { grid-column: 1 / -1; }

  .airport {
    display: flex;
    flex-direction: column;
    gap: .9rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  .airport:first-child { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }

  .airport header { display: flex; flex-direction: column; gap: .25rem; }
  .airport p { font-size: .95rem; }
  .airport h4 { margin-bottom: .5rem; font-size: .7rem; }
  .airport .more { margin-top: auto; }

  .routes {
    display: flex;
    flex-wrap: wrap;
    gap: .35rem;
  }

  .routes li {
    padding: .1rem .55rem;
    border: 1px solid var(--line);
    border-radius: 100px;
    font-size: .8rem;
    line-height: 1.5;
    white-space: nowrap;
  }

  .routes li.seasonal { border-style: dashed; border-color: var(--muted); }

  .announced {
    padding-top: .75rem;
    border-top: 1px dashed var(--line);
  }

  .announced .routes li {
    border-style: dotted;
    color: var(--muted);
  }

  .fine { font-size: .85rem; }

  @media (max-width: 860px) {
    .airports { grid-template-columns: 1fr; }
    .photo { aspect-ratio: 4 / 3; }
  }

  @media (max-width: 640px) {
    .wide { grid-column: 1 / -1; }
    .map { aspect-ratio: 4 / 3; }
    .sights { grid-template-columns: 1fr; }
  }
</style>
