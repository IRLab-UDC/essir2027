---
interface Props {
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<header class="container page-header">
  <p class="label">{eyebrow}</p>
  <h1>{title}</h1>
</header>

<style>
  .page-header { padding-block: clamp(3rem, 8vw, 5rem) clamp(1.5rem, 4vw, 2.5rem); }

  h1 {
    margin-top: .75rem;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -.04em;
    line-height: 1;
  }
</style>
