---
import type { Option } from '../data/travel';

const { options } = Astro.props as { options: Option[] };
---

<ul class="options" style={`--cols: ${options.length % 2 === 0 ? 2 : 3}`}>
  {options.map(o => (
    <li class="option">
      <span class="label">{o.mode}</span>
      <h3>{o.title}</h3>
      <p>{o.text}</p>
      {o.links && (
        <div class="links">
          {o.links.map(l => <a href={l.href}>{l.label} ↗</a>)}
        </div>
      )}
    </li>
  ))}
</ul>

<style>
  .options {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 1rem;
  }

  .option {
    display: flex;
    flex-direction: column;
    gap: .5rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  h3 {
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -.01em;
  }

  p { font-size: .95rem; }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: .25rem 1.25rem;
    margin-top: auto;
    padding-top: .25rem;
  }

  a {
    font-size: .9rem;
    font-weight: 500;
    transition: color .2s ease;
  }

  a:hover { color: var(--accent); }

  @media (max-width: 860px) {
    .options { grid-template-columns: 1fr; }
  }
</style>
